# =============================================================
# Align Academy — Environment Variables
# =============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================

# ── Supabase ─────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # ⚠️ server-side only

# ── Paystack ─────────────────────────────────────────────────
# Find these in: Paystack Dashboard → Settings → API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...                        # ⚠️ server-side only
PAYSTACK_WEBHOOK_SECRET=your-webhook-secret            # used to verify webhook signatures

# ── Resend ───────────────────────────────────────────────────
# Find this in: Resend Dashboard → API Keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@alignacademy.com

# ── App ──────────────────────────────────────────────────────
# Production: https://alignacademy.com (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Certificate verification public URL (usually same as APP_URL)
# Certificates will link to: {NEXT_PUBLIC_VERIFY_BASE_URL}/verify/{code}
NEXT_PUBLIC_VERIFY_BASE_URL=http://localhost:3000
